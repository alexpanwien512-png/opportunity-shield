# Nebius Token Factory — https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model IDs are confirmed with `npm run models` (GET /v1/models)
NEMOTRON_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
NEMOTRON_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily — https://app.tavily.com
TAVILY_API_KEY=

# Optional: raises GitHub API limit from 60 to 5000 req/h
GITHUB_TOKEN=

# SQLite file for profile, history, blacklist, rules
SHIELD_DB_PATH=data/shield.db

# Public demo hardening (unset = unlimited). Format: count/minutes per client IP, live runs only.
RATE_LIMIT_ANALYZE=
RATE_LIMIT_SCAN=
SCAN_MAX_LIMIT=12
# Set to DELETE when the DB sits on a network/shared filesystem
SHIELD_DB_JOURNAL=

{
  "name": "opportunity-shield",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "capture": "node --env-file-if-exists=.env --import tsx scripts/capture-fixtures.mts",
    "models": "node --env-file-if-exists=.env --import tsx scripts/list-models.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "warm": "node --import tsx scripts/warm.mts",
    "screenshots": "node --import tsx scripts/screenshots.mts"
  },
  "dependencies": {
    "@tavily/core": "^0.7.14",
    "better-sqlite3": "^13.0.3",
    "next": "16.4.2",
    "openai": "^7.39.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
